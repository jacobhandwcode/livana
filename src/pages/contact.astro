---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact - Livana, Soul Doula" description="Reach out for personalized support in your journey of self-discovery and transformation. Whether you have questions about offerings or want to connect, I'm here to help.">
    <div class="hero-section">
      <nav class="navigation">
        <ul class="nav-list">
          <li><a href="/" class="nav-link">ABOUT</a></li>
          <li><a href="/#offerings" class="nav-link">OFFERINGS</a></li>
          <li><a href="/contact" class="nav-link">CONTACT</a></li>
        </ul>
      </nav>

      <div class="hero-content">
        <img src="/logo.svg" alt="Livana Logo" class="hero-logo" style="width: 500px; filter: brightness(0) invert(1);" />
        <p class="description">
          Whether you're feeling called to explore this work, have questions
          about my offerings, or simply want to connect, I invite you to reach
          out. Every journey begins with a single step, and I'm here to support
          you as you take yours.
        </p>
      </div>
    </div>

    <section class="contact-section animate-on-scroll">
      <div class="contact-container">
        <div class="contact-content">
          <h2 class="contact-title animate-fade-up">Let's Connect</h2>
          <p class="contact-text animate-fade-up" style="animation-delay: 0.1s;">
            I believe in the power of authentic connection. If something in my
            work resonates with you, if you have questions about my offerings,
            or if you're simply curious about what this journey might look like
            for you, I'd love to hear from you.
          </p>
          <p class="contact-text animate-fade-up" style="animation-delay: 0.2s;">
            You don't have to have it all figured out to reach out. Sometimes
            the most profound transformations begin with a simple "I'm not sure
            what I need, but I know I need something different."
          </p>
          <p class="contact-text animate-fade-up" style="animation-delay: 0.3s;">
            I respond to all messages personally and with care. Whether you're
            ready to book a session or just want to explore what might be
            possible, your message is welcome.
          </p>

          <div class="contact-info animate-fade-up" style="animation-delay: 0.4s;">
            <div class="contact-item">
              <h3>Email</h3>
              <p><a href="mailto:livana@livanasouldoula.com" class="contact-link">livana@livanasouldoula.com</a></p>
            </div>
            <div class="contact-item">
              <h3>Phone</h3>
              <p><a href="tel:+14046175386" class="contact-link">+1 (404) 617-5386</a></p>
            </div>
            <div class="contact-item">
              <h3>Response Time</h3>
              <p>I typically respond within 24-48 hours</p>
            </div>
          </div>
        </div>

        <div class="contact-form-container animate-fade-up" style="animation-delay: 0.2s;">
          <form class="contact-form" id="contactForm" novalidate>
            <div id="formSuccess" class="form-success">
              Thank you — I'll respond within 24-48 hours.
            </div>
            <div id="formError" class="form-error"></div>

            <div class="form-group animate-fade-up" style="animation-delay: 0.3s;">
              <label for="name">Name *</label>
              <input type="text" id="name" name="name" required />
            </div>
            <div class="form-group animate-fade-up" style="animation-delay: 0.4s;">
              <label for="email">Email *</label>
              <input type="email" id="email" name="email" required />
            </div>
            <div class="form-group animate-fade-up" style="animation-delay: 0.5s;">
              <label for="phone">Phone Number</label>
              <input type="tel" id="phone" name="phone" />
            </div>
            <div class="form-group animate-fade-up" style="animation-delay: 0.6s;">
              <label for="consultation">Are you interested in a free 20-minute consultation?</label>
              <select id="consultation" name="consultation">
                <option value="">Please select</option>
                <option value="yes">Yes, I'd like to schedule a consultation</option>
                <option value="no">No, I have other questions</option>
                <option value="maybe">I'm not sure yet</option>
              </select>
            </div>
            <div class="form-group animate-fade-up" style="animation-delay: 0.7s;">
              <label for="message">Message *</label>
              <textarea
                id="message"
                name="message"
                rows="6"
                required
                placeholder="I'd love to hear what brought you here today..."
              ></textarea>
            </div>
            <button type="submit" class="submit-button animate-fade-up" style="animation-delay: 0.8s;">Send Message</button>
          </form>
        </div>
      </div>
    </section>

    <section class="consultation-section animate-on-scroll">
      <div class="consultation-container">
        <h2 class="consultation-title animate-fade-up">Free 20-Minute Consultation</h2>
        <p class="consultation-text animate-fade-up" style="animation-delay: 0.1s;">
          Not sure if we're a good fit? I offer a complimentary 20-minute
          consultation where we can connect, you can ask questions, and we can
          both feel into whether this work aligns with what you're seeking.
          There's no pressure—just presence and authentic conversation.
        </p>
        <p class="consultation-text animate-fade-up" style="animation-delay: 0.2s;">
          To schedule your free consultation, simply mention it in your message
          above, and I'll respond with available times that work for both of us.
        </p>
      </div>
    </section>

    <footer class="footer-section animate-on-scroll">
      <div class="footer-container">
        <div class="footer-logo animate-fade-up">
          <img src="/logo.svg" alt="Livana Logo" class="footer-logo-image" />
        </div>

        <div class="footer-column footer-contact animate-fade-up" style="animation-delay: 0.1s;">
          <h3>Contact</h3>
          <p><a href="mailto:livana@livanasouldoula.com" class="contact-link">livana@livanasouldoula.com</a></p>
          <p><a href="tel:+14046175386" class="contact-link">+1 (404) 617-5386</a></p>
        </div>

        <div class="footer-column animate-fade-up" style="animation-delay: 0.2s;">
          <h3>Quick Links</h3>
          <ul class="footer-links">
            <li><a href="/#about">About</a></li>
            <li><a href="/#offerings">Offerings</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/disclaimer">Disclaimer</a></li>
          </ul>
        </div>

        <div class="footer-message animate-fade-up" style="animation-delay: 0.3s;">
          <p class="footer-message-text">
            Walk confidently toward a more aligned and fulfilled life.
          </p>
        </div>
      </div>
    </footer>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    font-family: 'Georgia', serif;
    color: white;
    overflow-x: hidden;
    scroll-behavior: smooth;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .animate-on-scroll {
    opacity: 0;
    transform: translateY(50px);
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .animate-fade-up {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .animate-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-section {
    min-height: 60vh;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 2rem;
  }

  .hero-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('/bg.jpg');
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    z-index: -1;
  }

  .navigation {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: 2rem 4rem;
    z-index: 10;
  }

  .nav-list {
    display: flex;
    justify-content: center;
    gap: 4rem;
    list-style: none;
  }

  .nav-link {
    color: white;
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 300;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    position: relative;
  }

  .nav-link:hover {
    opacity: 0.8;
    transform: translateY(-2px);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 1px;
    background: white;
    transition: width 0.3s ease;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .hero-content {
    max-width: 800px;
    z-index: 5;
    padding-top: 14rem;
  }

  .description {
    font-size: 1.2rem;
    line-height: 1.8;
    margin-bottom: 3rem;
    font-weight: 300;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    opacity: 0;
    animation: fadeInUp 1s ease forwards 1.1s;
  }

  .contact-section {
    background: #f8f4ff;
    color: #2d2d3d;
    padding: 6rem 2rem;
  }

  .contact-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-content {
    opacity: 0;
    animation: fadeInUp 0.8s ease forwards 0.3s;
  }

  .contact-title {
    font-size: 3rem;
    font-weight: 300;
    margin-bottom: 2rem;
    color: #4a4a6a;
    letter-spacing: 1px;
    line-height: 1.2;
  }

  .contact-text {
    font-size: 1rem;
    line-height: 1.8;
    color: #444;
    margin-bottom: 1.5rem;
    font-weight: 300;
  }

  .contact-info {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .contact-item h3 {
    font-size: 1.2rem;
    font-weight: 400;
    color: #4a4a6a;
    margin-bottom: 0.5rem;
    letter-spacing: 0.5px;
  }

  .contact-item p {
    font-size: 1rem;
    color: #ccc;
    font-weight: 300;
  }

  .contact-link {
    color: #ccc;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 300;
    transition: color 0.3s ease;
  }

  .contact-link:hover {
    color: #fff;
    text-decoration: underline;
  }

  .contact-content .contact-link {
    color: #666;
  }

  .contact-content p {
    color: #666;
  }

  .contact-content .contact-link:hover {
    color: #4a4a6a;
  }

  .contact-form-container {
    opacity: 0;
    animation: fadeInUp 0.8s ease forwards 0.6s;
  }

  .contact-form {
    background: white;
    padding: 3rem;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    border: 1px solid #f0f0f0;
  }

  .form-group {
    margin-bottom: 2rem;
  }

  .form-group label {
    display: block;
    font-size: 1rem;
    font-weight: 400;
    color: #4a4a6a;
    margin-bottom: 0.5rem;
    letter-spacing: 0.5px;
  }

  .form-group input,
  .form-group textarea,
  .form-group select {
    width: 100%;
    padding: 1rem;
    border: 2px solid #e8e8e8;
    border-radius: 10px;
    font-size: 1rem;
    font-family: 'Georgia', serif;
    color: #444;
    background: white;
    transition: all 0.3s ease;
  }

  .form-group input:focus,
  .form-group textarea:focus,
  .form-group select:focus {
    outline: none;
    border-color: #c4a5c7;
    box-shadow: 0 0 0 3px rgba(196, 165, 199, 0.1);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-group textarea::placeholder {
    color: #999;
    font-style: italic;
  }

  .form-group select {
    cursor: pointer;
  }

  .submit-button {
    width: 100%;
    padding: 1.2rem;
    background: linear-gradient(135deg, #6b5b95, #8b7faa);
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 1.1rem;
    font-weight: 400;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 10px 30px rgba(107, 91, 149, 0.3);
    font-family: 'Georgia', serif;
  }

  .submit-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 40px rgba(107, 91, 149, 0.4);
    background: linear-gradient(135deg, #5a4a85, #7a6f9a);
  }

  .submit-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .consultation-section {
    background: white;
    color: #2d2d3d;
    padding: 4rem 2rem;
    text-align: center;
  }

  .consultation-container {
    max-width: 800px;
    margin: 0 auto;
    opacity: 0;
    animation: fadeInUp 0.8s ease forwards 0.3s;
  }

  .consultation-title {
    font-size: 2.5rem;
    font-weight: 300;
    margin-bottom: 2rem;
    color: #4a4a6a;
    letter-spacing: 1px;
  }

  .consultation-text {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #444;
    margin-bottom: 1.5rem;
    font-weight: 300;
  }

  .footer-section {
    background: #2d2d3d;
    color: white;
    padding: 4rem 2rem 2rem 2rem;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 2fr;
    gap: 3rem;
    align-items: start;
  }

  .footer-logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .footer-logo-image {
    width: 130px;
    height: 130px;
    border-radius: 10px;
    margin-bottom: 1rem;
    object-fit: cover;
    filter: brightness(0) invert(1);
  }

  .footer-column h3 {
    font-size: 1.2rem;
    font-weight: 400;
    margin-bottom: 1.5rem;
    color: white;
    letter-spacing: 0.5px;
  }

  .footer-contact p {
    margin-bottom: 0.5rem;
    color: #ccc;
    font-size: 0.95rem;
    font-weight: 300;
  }

  .footer-links {
    list-style: none;
  }

  .footer-links li {
    margin-bottom: 0.8rem;
  }

  .footer-links a {
    color: #ccc;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 300;
    transition: color 0.3s ease;
  }

  .footer-links a:hover {
    color: white;
  }

  .footer-message {
    text-align: right;
    padding-left: 2rem;
  }

  .footer-message-text {
    font-size: 1.8rem;
    font-weight: 300;
    line-height: 1.4;
    color: #b8b8b8;
    letter-spacing: 0.5px;
    font-style: italic;
  }

  .form-success {
    background: #f0eaff;
    color: #4a4a6a;
    padding: 1rem;
    border-radius: 10px;
    margin-bottom: 2rem;
    border: 1px solid #c4a5c7;
    display: none;
  }

  .form-error {
    background: #f8d7da;
    color: #721c24;
    padding: 1rem;
    border-radius: 10px;
    margin-bottom: 2rem;
    border: 1px solid #f5c6cb;
    display: none;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .navigation {
      padding: 2rem 0;
    }

    .nav-list {
      gap: 2rem;
      flex-wrap: wrap;
    }

    .nav-link {
      font-size: 1rem;
    }

    .hero-content img {
      width: 300px !important;
    }

    .description {
      font-size: 1rem;
      padding: 0 1rem;
    }

    .contact-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .contact-title {
      font-size: 2.2rem;
    }

    .contact-text {
      font-size: 0.95rem;
    }

    .contact-form {
      padding: 2rem 1.5rem;
    }

    .consultation-title {
      font-size: 2rem;
    }

    .consultation-text {
      font-size: 1rem;
    }

    .footer-container {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }

    .footer-message {
      text-align: center;
      padding-left: 0;
    }

    .footer-message-text {
      font-size: 1.4rem;
    }
  }

  @media (max-width: 480px) {
    .contact-title {
      font-size: 1.8rem;
    }

    .consultation-title {
      font-size: 1.8rem;
    }

    .contact-form {
      padding: 1.5rem 1rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) entry.target.classList.add('animate-visible');
      });
    }, { root: null, rootMargin: '0px 0px -100px 0px', threshold: 0.1 });

    document.querySelectorAll('.animate-on-scroll, .animate-fade-up').forEach(el => observer.observe(el));

    const form = document.getElementById('contactForm') as HTMLFormElement;
    const submitBtn = form.querySelector('.submit-button') as HTMLButtonElement;
    const successMsg = document.getElementById('formSuccess') as HTMLElement;
    const errorMsg = document.getElementById('formError') as HTMLElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const originalText = submitBtn.textContent;
      submitBtn.textContent = 'Sending...';
      submitBtn.disabled = true;
      successMsg.style.display = 'none';
      errorMsg.style.display = 'none';

      const payload = {
        name:         (form.querySelector('#name') as HTMLInputElement).value.trim(),
        email:        (form.querySelector('#email') as HTMLInputElement).value.trim(),
        phone:        (form.querySelector('#phone') as HTMLInputElement).value.trim(),
        consultation: (form.querySelector('#consultation') as HTMLSelectElement).value,
        message:      (form.querySelector('#message') as HTMLTextAreaElement).value.trim(),
      };

      try {
        const res = await fetch('/form-handler.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();

        if (data.success) {
          successMsg.textContent = data.message;
          successMsg.style.display = 'block';
          form.reset();
          submitBtn.textContent = 'Sent!';
        } else {
          errorMsg.textContent = data.message || 'Something went wrong. Please try again.';
          errorMsg.style.display = 'block';
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
        }
      } catch {
        errorMsg.textContent = 'Something went wrong. Please email livana@livanasouldoula.com directly.';
        errorMsg.style.display = 'block';
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
      }
    });
  });
</script>
</Layout>